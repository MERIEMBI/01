#include <stdio.h>
#include <stdlib.h>
#include <pthread.h>

void* identify_thread(void* arg) {
    // استخدام pthread_self لجلب معرف الخيط الحالي
    pthread_t self_id = pthread_self();
    printf("I am a thread, and my pthread_self() ID is: %lu\n", self_id);
    return NULL;
}

int main() {
    pthread_t t;
    pthread_create(&t, NULL, identify_thread, NULL);
    pthread_join(t, NULL);
    return 0;
}
