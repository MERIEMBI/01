#include <stdio.h>
#include <stdlib.h>
#include <unistd.h>
#include <sys/types.h>
#include <sys/wait.h>

int main() {
    pid_t pid1 = fork();
    if (pid1 < 0) {
        perror("Error: fork failed");
        exit(1);
    } else if (pid1 == 0) {
        printf("First Child Process (PID: %d)\n", getpid());
        exit(0);
    }

    pid_t pid2 = fork();
    if (pid2 < 0) {
        perror("Error: fork failed");
        exit(1);
    } else if (pid2 == 0) {
        printf("Second Child Process (PID: %d)\n", getpid());
        exit(0);
    }

    // الأب ينتظر كلا الطفلين
    wait(NULL);
    wait(NULL);
    printf("Parent process waited for both children.\n");
    return 0;
}
