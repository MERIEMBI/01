#include <stdio.h>
#include <stdlib.h>
#include <unistd.h>
#include <sys/types.h>
#include <sys/wait.h>

int main() {
    pid_t pid = fork();

    if (pid < 0) {
        perror("fork failed");
        exit(1);
    } else if (pid == 0) {
        // العملية الفرعية تنفذ برنامج ls -l
        char *args[] = {"ls", "-l", NULL};
        execvp(args[0], args);
        perror("execvp failed");
        exit(1);
    } else {
        // العملية الأب تنتظر انتهاء الابن لتجنب الزومبي
        wait(NULL);
        printf("Parent process: Child has terminated.\n");
    }
    return 0;
}
